{
  "templateId": "anima-trellis2-text-to-3d",
  "nodePackId": "anima",
  "requires": ["anima", "image-background-remover", "trellis2"],
  "name": "Text to 3D (Anima + Cutout + Trellis.2)",
  "description": "Generate a stylized illustration with Anima, remove its background, then turn the transparent image into a 3D mesh with Trellis.2.",
  "nodes": [
    {
      "id": "text-input",
      "type": "textNode",
      "position": { "x": 80, "y": 180 },
      "data": {
        "enabled": true,
        "params": { "text": "" }
      }
    },
    {
      "id": "generate-image",
      "type": "nodePackNode",
      "position": { "x": 390, "y": 180 },
      "data": {
        "nodePackId": "anima/generate",
        "enabled": true,
        "params": {}
      }
    },
    {
      "id": "remove-background",
      "type": "nodePackNode",
      "position": { "x": 720, "y": 180 },
      "data": {
        "nodePackId": "image-background-remover/remove-background",
        "enabled": true,
        "params": { "model": "isnet-anime" }
      }
    },
    {
      "id": "generate-mesh",
      "type": "nodePackNode",
      "position": { "x": 1050, "y": 180 },
      "data": {
        "nodePackId": "trellis2/generate",
        "enabled": true,
        "params": {}
      }
    },
    {
      "id": "scene-output",
      "type": "outputNode",
      "position": { "x": 1380, "y": 180 },
      "data": {
        "enabled": true,
        "params": {}
      }
    }
  ],
  "edges": [
    {
      "id": "text-to-image",
      "source": "text-input",
      "target": "generate-image",
      "targetHandle": "input-0"
    },
    {
      "id": "image-to-cutout",
      "source": "generate-image",
      "target": "remove-background",
      "targetHandle": "input-0"
    },
    {
      "id": "cutout-to-mesh",
      "source": "remove-background",
      "target": "generate-mesh",
      "targetHandle": "input-0"
    },
    {
      "id": "mesh-to-scene",
      "source": "generate-mesh",
      "sourceHandle": "output",
      "target": "scene-output"
    }
  ]
}
