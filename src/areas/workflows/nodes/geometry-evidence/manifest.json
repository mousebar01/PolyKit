{
  "id": "geometry-evidence",
  "name": "Geometry Evidence",
  "type": "process",
  "entry": "processor.py",
  "version": "1.0.0",
  "author": "PolyKit",
  "description": "Measures shape-specific geometry such as swept arc radius and angular span.",
  "requirements": [],
  "i18n": {
    "zh-CN": { "name": "几何证据", "description": "测量扫掠弧线半径、角跨度等形状特征。" },
    "en-US": { "name": "Geometry Evidence", "description": "Measures shape-specific geometry such as swept arc radius and angular span." }
  },
  "nodes": [
    {
      "id": "swept-arc-audit",
      "name": "Swept Arc Audit",
      "input": "text",
      "output": "text",
      "description": "Fits a best plane and circular arc to component points, rejecting straight rods that only look curved in silhouette.",
      "i18n": {
        "zh-CN": { "name": "扫掠弧线审计" },
        "en-US": { "name": "Swept Arc Audit" }
      },
      "params_schema": [
        { "id": "min_planarity", "label": "Min Planarity", "type": "float", "default": 0.35, "min": 0.0, "max": 1.0 },
        { "id": "min_angular_span_deg", "label": "Min Arc Span", "type": "float", "default": 90.0, "min": 0.0, "max": 359.0 },
        { "id": "max_centre_distance_over_extent", "label": "Max Centre Distance", "type": "float", "default": 2.0, "min": 0.0, "max": 100.0 },
        { "id": "bend_radius", "label": "Expected Bend Radius", "type": "float", "default": 0.0, "min": 0.0, "max": 10000.0 },
        { "id": "bend_radius_tolerance", "label": "Radius Tolerance", "type": "float", "default": 0.0, "min": 0.0, "max": 10000.0 },
        { "id": "max_radius_spread_ratio", "label": "Max Arc Residual", "type": "float", "default": 0.15, "min": 0.0, "max": 1.0 }
      ]
    }
  ]
}
