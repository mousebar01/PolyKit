{
  "name": "polykit",
  "description": "Local AI-powered 3D mesh generation from images",
  "author": "PolyKit",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-builtins.mjs && vite --config vite.web.config.ts",
    "web": "node scripts/build-builtins.mjs && vite --config vite.web.config.ts",
    "web:build": "node scripts/build-builtins.mjs && vite build --config vite.web.config.ts",
    "web:preview": "vite preview --config vite.web.config.ts",
    "web:serve": "npm run web:build && node scripts/serve-web.mjs",
    "build:web": "npm run web:build",
    "build": "npm run web:build",
    "preview": "npm run web:preview",
    "typecheck": "tsc --noEmit -p tsconfig.web.json",
    "check": "npm run lint && npm run typecheck && npm test",
    "prepare": "node scripts/setup-hooks.mjs",
    "test": "npm run test:py && npm run test:cli && npm run test:node",
    "test:py": "node scripts/run-pytests.mjs",
    "test:cli": "node scripts/run-cli-tests.mjs",
    "test:node": "node --test --experimental-strip-types --experimental-loader ./scripts/node-ts-extensionless-loader.mjs src/shared/i18n.test.ts src/shared/stores/workflowsStore.test.ts src/shared/types/assetLibrary.test.ts src/areas/assets/assetLibraryProjection.test.ts src/areas/assets/assetLibraryService.test.ts src/areas/assets/assetLibraryUi.test.ts && node --test src/**/*.test.mjs",
    "lint": "eslint ."
  },
  "dependencies": {
    "@mkkellogg/gaussian-splats-3d": "^0.4.7",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.5",
    "@react-three/drei": "^9.120.0",
    "@react-three/fiber": "^8.17.10",
    "@react-three/postprocessing": "^2.19.1",
    "@xyflow/react": "^12.10.2",
    "axios": "^1.7.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^1.7.1",
    "tailwind-merge": "^2.6.0",
    "tar": "^7.5.9",
    "three": "^0.171.0",
    "three-mesh-bvh": "^0.9.9",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/tar": "^7.0.87",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.61.1",
    "vite": "^5.4.0"
  }
}
