{
  "id": "trellis2",
  "name": "Trellis.2 GGUF",
  "type": "model",
  "source": "https://huggingface.co/Aero-Ex/Trellis2-GGUF",
  "description": "Aero-Ex Trellis.2 — GGUF quantized image-to-3D model (1–3 B params). Generates a geometry mesh in one pass via sparse structure + shape SLaT. Requires ~6–10 GB VRAM depending on quantization.",
  "version": "1.0.7",
  "author": "Lightning Pixel",
  "generator_class": "Trellis2GGUFGenerator",
  "vram_gb": 8,
  "env": "shared",
  "trusted": true,
  "builtin": true,
  "tags": ["image-to-3d", "gguf", "quantized"],
  "requirements": ["Pillow", "numpy", "scipy", "trimesh", "pymeshlab", "meshlib", "opencv-python-headless", "gguf", "sdnq", "open3d", "rectpack", "requests", "plyfile", "zstandard", "tqdm", "huggingface_hub", "transformers==5.2.0", "accelerate", "einops", "easydict", "rembg", "onnxruntime"],
  "download": {
    "kind": "huggingface",
    "repo": "Aero-Ex/Trellis2-GGUF",
    "location": "trellis2",
    "check": "pipeline.json",
    "note": "GGUF quantised weights; ~3-8 GB for a single quantisation, up to ~25 GB for all variants."
  },
  "nodes": [
    {
      "id": "generate",
      "name": "Generate Mesh",
      "i18n": {
        "zh-CN": { "name": "生成网格" }
      },
      "input": "image",
      "output": "mesh",
      "hf_repo": "Aero-Ex/Trellis2-GGUF",
      "download_check": "pipeline.json",
      "hf_include_prefixes": [
        "pipeline.json",
        "texturing_pipeline.json",
        "Vision/",
        "decoders/",
        "encoders/",
        "refiner/ss_flow_img_dit_1_3B_64_bf16.json",
        "refiner/ss_flow_img_dit_1_3B_64_bf16_Q",
        "shape/slat_flow_img2shape_dit_1_3B_1024_bf16.json",
        "shape/slat_flow_img2shape_dit_1_3B_1024_bf16_Q",
        "shape/slat_flow_img2shape_dit_1_3B_512_bf16.json",
        "shape/slat_flow_img2shape_dit_1_3B_512_bf16_Q",
        "texture/slat_flow_imgshape2tex_dit_1_3B_1024_bf16.json",
        "texture/slat_flow_imgshape2tex_dit_1_3B_1024_bf16_Q",
        "texture/slat_flow_imgshape2tex_dit_1_3B_512_bf16.json",
        "texture/slat_flow_imgshape2tex_dit_1_3B_512_bf16_Q"
      ],
      "params_schema": [
        {
          "id": "pipeline_type",
          "label": "Quality",
          "type": "select",
          "default": "1024_cascade",
          "tooltip": "Resolution and number of cascade steps. Higher = better detail, slower.",
          "i18n": {
            "zh-CN": {
              "label": "质量",
              "tooltip": "分辨率与 Cascade 步数。设置越高通常细节越好，但速度更慢。"
            }
          },
          "options": [
            { "value": "512", "label": "Fast (512)", "i18n": { "zh-CN": { "label": "快速（512）" } } },
            { "value": "1024", "label": "Balanced (1024)", "i18n": { "zh-CN": { "label": "均衡（1024）" } } },
            { "value": "1024_cascade", "label": "High (1024 cascade)", "i18n": { "zh-CN": { "label": "高质量（1024 Cascade）" } } },
            { "value": "1536_cascade", "label": "Ultra (1536 cascade)", "i18n": { "zh-CN": { "label": "极致（1536 Cascade）" } } }
          ]
        },
        {
          "id": "gguf_quant",
          "label": "GGUF Quantization",
          "type": "select",
          "default": "Q5_K_M",
          "tooltip": "GGUF quantization level. Less VRAM = slightly less accurate.",
          "i18n": {
            "zh-CN": {
              "label": "GGUF 量化",
              "tooltip": "GGUF 量化等级。较低量化通常占用更少 VRAM，但精度可能略有下降。"
            }
          },
          "options": [
            { "value": "Q4_K_M", "label": "Q4_K_M" },
            { "value": "Q5_K_M", "label": "Q5_K_M" },
            { "value": "Q6_K", "label": "Q6_K" },
            { "value": "Q8_0", "label": "Q8_0" }
          ]
        },
        {
          "id": "ss_steps",
          "label": "Sparse Steps",
          "type": "int",
          "default": 25,
          "min": 1,
          "max": 50,
          "tooltip": "Diffusion steps for the sparse structure (coarse geometry). More = better quality, slower.",
          "i18n": {
            "zh-CN": {
              "label": "稀疏结构步数",
              "tooltip": "稀疏结构（粗几何）的扩散步数。步数越多通常质量越高，但速度更慢。"
            }
          }
        },
        {
          "id": "slat_steps",
          "label": "Shape Steps",
          "type": "int",
          "default": 25,
          "min": 1,
          "max": 50,
          "tooltip": "Diffusion steps for the geometry SLaT (fine details).",
          "i18n": {
            "zh-CN": {
              "label": "几何步数",
              "tooltip": "几何 SLaT（精细细节）的扩散步数。"
            }
          }
        },
        {
          "id": "foreground_ratio",
          "label": "Foreground Ratio",
          "type": "float",
          "default": 0.85,
          "min": 0.5,
          "max": 1.0,
          "step": 0.05,
          "tooltip": "Proportion of the canvas occupied by the subject after background removal.",
          "i18n": {
            "zh-CN": {
              "label": "前景比例",
              "tooltip": "移除背景后，主体在画布中所占的比例。"
            }
          }
        },
        {
          "id": "remesh_resolution",
          "label": "Remesh Resolution",
          "type": "select",
          "default": 768,
          "options": [
            { "value": 512, "label": "512" },
            { "value": 768, "label": "768" },
            { "value": 1024, "label": "1024" }
          ],
          "tooltip": "Voxel grid resolution used for the post-generation narrow-band remesh. Higher = fewer holes and junction artifacts, but more VRAM and time.",
          "i18n": {
            "zh-CN": {
              "label": "重网格分辨率",
              "tooltip": "生成后窄带重网格使用的体素分辨率。更高通常能减少孔洞和连接伪影，但会占用更多 VRAM 和时间。"
            }
          }
        },
        {
          "id": "seed",
          "label": "Seed",
          "type": "int",
          "default": 0,
          "min": -1,
          "max": 4294967295,
          "tooltip": "Seed for reproducibility. -1 = random.",
          "i18n": {
            "zh-CN": {
              "label": "Seed",
              "tooltip": "固定 Seed 可复现生成结果。-1 表示随机。"
            }
          }
        }
      ]
    },
    {
      "id": "refine",
      "name": "Texture Mesh",
      "i18n": {
        "zh-CN": { "name": "纹理网格" }
      },
      "input": "image",
      "inputs": ["image", "mesh"],
      "output": "mesh",
      "hf_repo": "Aero-Ex/Trellis2-GGUF",
      "download_check": "pipeline.json",
      "hf_include_prefixes": [
        "pipeline.json",
        "texturing_pipeline.json",
        "Vision/",
        "decoders/",
        "encoders/",
        "refiner/ss_flow_img_dit_1_3B_64_bf16.json",
        "refiner/ss_flow_img_dit_1_3B_64_bf16_Q",
        "shape/slat_flow_img2shape_dit_1_3B_1024_bf16.json",
        "shape/slat_flow_img2shape_dit_1_3B_1024_bf16_Q",
        "shape/slat_flow_img2shape_dit_1_3B_512_bf16.json",
        "shape/slat_flow_img2shape_dit_1_3B_512_bf16_Q",
        "texture/slat_flow_imgshape2tex_dit_1_3B_1024_bf16.json",
        "texture/slat_flow_imgshape2tex_dit_1_3B_1024_bf16_Q",
        "texture/slat_flow_imgshape2tex_dit_1_3B_512_bf16.json",
        "texture/slat_flow_imgshape2tex_dit_1_3B_512_bf16_Q"
      ],
      "params_schema": [
        {
          "id": "texture_resolution",
          "label": "Texture Resolution",
          "type": "select",
          "default": 1024,
          "tooltip": "Diffusion resolution for texture SLaT encoding. 1024 gives better quality.",
          "i18n": {
            "zh-CN": {
              "label": "纹理分辨率",
              "tooltip": "纹理 SLaT 编码使用的扩散分辨率。1024 通常能获得更好的质量。"
            }
          },
          "options": [
            { "value": 512, "label": "512" },
            { "value": 1024, "label": "1024" }
          ]
        },
        {
          "id": "texture_size",
          "label": "Texture Atlas Size",
          "type": "select",
          "default": 2048,
          "tooltip": "Output texture atlas resolution. Larger = sharper textures.",
          "i18n": {
            "zh-CN": {
              "label": "纹理图集尺寸",
              "tooltip": "输出纹理图集的分辨率。尺寸越大，纹理通常越清晰。"
            }
          },
          "options": [
            { "value": 1024, "label": "1024" },
            { "value": 2048, "label": "2048" }
          ]
        },
        {
          "id": "texture_steps",
          "label": "Texture Steps",
          "type": "int",
          "default": 12,
          "min": 4,
          "max": 50,
          "tooltip": "Diffusion steps for texture generation. More = better quality, slower.",
          "i18n": {
            "zh-CN": {
              "label": "纹理生成步数",
              "tooltip": "纹理生成的扩散步数。步数越多通常质量越高，但速度更慢。"
            }
          }
        },
        {
          "id": "texture_guidance",
          "label": "Guidance Strength",
          "type": "float",
          "default": 3.0,
          "min": 0.0,
          "max": 5.0,
          "step": 0.1,
          "tooltip": "Classifier-free guidance strength for texture diffusion.",
          "i18n": {
            "zh-CN": {
              "label": "Guidance 强度",
              "tooltip": "纹理扩散使用的 classifier-free guidance 强度。"
            }
          }
        },
        {
          "id": "foreground_ratio",
          "label": "Foreground Ratio",
          "type": "float",
          "default": 0.85,
          "min": 0.5,
          "max": 1.0,
          "step": 0.05,
          "tooltip": "Proportion of the canvas occupied by the subject after background removal.",
          "i18n": {
            "zh-CN": {
              "label": "前景比例",
              "tooltip": "移除背景后，主体在画布中所占的比例。"
            }
          }
        },
        {
          "id": "seed",
          "label": "Seed",
          "type": "int",
          "default": 0,
          "min": -1,
          "max": 4294967295,
          "tooltip": "Seed for reproducibility. -1 = random.",
          "i18n": {
            "zh-CN": {
              "label": "Seed",
              "tooltip": "固定 Seed 可复现生成结果。-1 表示随机。"
            }
          }
        }
      ]
    }
  ]
}
